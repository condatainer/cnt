#!/usr/bin/env bash
#DESC:GENCODE {gencode_version} GRCh38 transcript sequences FASTA
#URL:https://www.gencodegenes.org/human/
#ARCH:noarch
#TARGET:grch38/transcript/gencode/{gencode_version}

#PH:gencode_version:23-50

#AUTOUPDATE:gencode_version:listing https://ftp.ebi.ac.uk/pub/databases/gencode/Gencode_human/ regex=release_(\d+)/ min=23 verify=head

#SOURCE:transcripts https://ftp.ebi.ac.uk/pub/databases/gencode/Gencode_human/release_{gencode_version}/gencode.v{gencode_version}.transcripts.fa.gz

#ENV:TRANSCRIPT_FASTA={prefix}/gencode.v{gencode_version}.transcripts.fa   ## GENCODE {gencode_version} GRCh38 transcript sequences FASTA

cd "$CNT_BUILD_PREFIX"

echo "Decompressing the transcripts" >&2
pigz -dc -p "${NCPU:-4}" "$CNT_BUILD_SRC_transcripts" > "gencode.v{gencode_version}.transcripts.fa"
