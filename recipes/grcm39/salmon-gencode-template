#!/usr/bin/env bash
#DESC:Salmon {salmon_version} transcriptome index for GENCODE M{gencode_version} GRCm39 (k-mer {kmer_length})
#URL:https://combine-lab.github.io/salmon/
#TARGET:grcm39/salmon/{salmon_version}/gencodeM{gencode_version}-k{kmer_length}

#PH:salmon_version:2.8.0,2.7.0,2.6.0,2.5.1,2.5.0,2.4.1,2.4.0,2.3.4,2.3.3,2.3.2,2.3.1,2.3.0,2.2.1,2.1.2,2.1.1,2.1.0,2.0.1,2.0.0,1.12.1,1.12.0,1.11.4,1.10.3,1.10.2,1.10.1,1.10.0,1.9.0
#PH:gencode_version:26-39
