#AUTOUPDATE:salmon_version:conda bioconda::salmon min=1.9.0
#AUTOUPDATE:gencode_version:dep from=grcm39/transcript/gencode regex=^M(\d+)$

#DEP:salmon/{salmon_version}
#DEP:grcm39/transcript/gencode/M{gencode_version}

#ENV:SALMON_INDEX_DIR={prefix}   ## Salmon {salmon_version} transcriptome index for GENCODE M{gencode_version} GRCm39 (k-mer {kmer_length})

#NCPU: 16
#MEM: 24G
#TIME: 2:00:00

echo "Building Salmon index for $CNT_BUILD_NAME" >&2
salmon index \
    -p "$NCPU" \
    -t "$TRANSCRIPT_FASTA" \
    -k {kmer_length} \
    -i "$CNT_BUILD_PREFIX" \
    --gencode
