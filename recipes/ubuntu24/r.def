#DESC:R {version} on Ubuntu 24.04 (noble)
#URL:https://hub.docker.com/r/posit/r-base
#TARGET:ubuntu24/r/{version}

#PH:version:4.6.1,4.6.0,4.5.3,4.5.2,4.5.1,4.5.0,4.4.3,4.4.2,4.4.1,4.4.0,4.3.3,4.3.2,4.3.1,4.3.0,4.2.3,4.2.2,4.2.1,4.2.0,4.1.3,4.1.2,4.1.1,4.1.0,4.0.5,4.0.4,4.0.3,4.0.2,4.0.1,4.0.0,3.6.3,3.6.2,3.6.1,3.6.0,3.5.3,3.4.4,3.3.3,3.2.5,3.1.3

#AUTOUPDATE:version:docker posit/r-base filter=noble regex=^(\d+\.\d+\.\d+)-noble$ min=3.1.3

Bootstrap: docker
From: posit/r-base:{version}-noble

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    export PS1='CNT \w> '

%runscript
    exec /usr/bin/R "$@"
