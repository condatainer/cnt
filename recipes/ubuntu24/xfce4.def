#DESC:XFCE4 desktop on Ubuntu 24.04
#URL:https://www.xfce.org

Bootstrap: docker
From: ubuntu:24.04

%labels
    Description "Ubuntu24 with XFCE4 desktop"

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    export PS1='CNT \w> '

%runscript
    exec /bin/bash "$@"	

%post
    # Avoid interactive prompts
    export DEBIAN_FRONTEND=noninteractive

    # A root-mapped build has one uid, so apt cannot drop to its _apt user.
    echo 'APT::Sandbox::User "root";' > /etc/apt/apt.conf.d/99-no-sandbox

    apt-get -y update

    # Desktop
    # XFCE4 and some useful tools
    # xfce4-terminal: terminal emulator
    # mousepad: text editor
    # xfce4-screenshooter: screenshot tool
    # ristretto: image viewer
    # xfce4-whiskermenu-plugin: start menu
    # vlc: media player
    # audacious: music player
    # drawing: simple drawing tool
    # thunar-archive-plugin, file-roller: create and extract archives from the file manager
    # atril: PDF viewer
    # xfce4-taskmanager: process and memory monitor
    apt-get -y install dbus-x11 pulseaudio ffmpeg xfce4 \
        xfce4-terminal mousepad xfce4-screenshooter \
        ristretto xfce4-whiskermenu-plugin \
        vlc audacious drawing \
        thunar-archive-plugin file-roller \
        atril xfce4-taskmanager

    # xfce4-session recommends a screen locker, and a locked session cannot be
    # unlocked: the container has no password for the user.
    apt-get -y purge light-locker

    # Fonts
    # fonts-noto-cjk: Chinese, Japanese and Korean
    # fonts-liberation: Arial, Times New Roman and Courier New metrics
    # fonts-noto-color-emoji: emoji
    apt-get -y install fonts-noto-cjk fonts-liberation fonts-noto-color-emoji

    # FireFox
    apt-get -y install software-properties-common
    add-apt-repository -y ppa:mozillateam/ppa
    apt-get -y install firefox-esr

    # OpenGL/Vulkan/OpenCL — software rendering fallback + scientific viz deps + diagnostics
    apt-get -y install \
        libgl1-mesa-dri libglu1-mesa libglew2.2 libosmesa6 libegl-mesa0 \
        mesa-utils \
        libvulkan1 mesa-vulkan-drivers vulkan-tools \
        ocl-icd-libopencl1 pocl-opencl-icd clinfo

    apt-get clean && rm -rf /var/lib/apt/lists/*
    rm -f /etc/apt/apt.conf.d/99-no-sandbox
