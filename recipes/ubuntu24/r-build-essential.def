#DESC: Ubuntu 24.04 compilers, build tools and system libraries for R

Bootstrap: docker
From: ubuntu:24.04

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    export PS1='CNT \w> '

%runscript
    exec /bin/bash "$@"	

%post
    # Avoid interactive prompts
    export DEBIAN_FRONTEND=noninteractive

    # A root-mapped build has one uid, so apt cannot drop to its _apt user.
    echo 'APT::Sandbox::User "root";' > /etc/apt/apt.conf.d/99-no-sandbox

    apt-get -y update && apt-get -y upgrade

    ## C and C++
    apt-get -y install \
        build-essential pkg-config git wget curl zip \
        g++ clang gfortran \
        ninja-build make cmake doxygen autoconf automake

    ## RStudio libs
    apt-get -y install libssl-dev libclang-dev libsqlite3-0
    apt-get -y install pandoc # for markdown rendering

    ## Python
    apt-get -y install python3-pip python3-venv python-is-python3
    # PyTorch
    apt-get -y install libglib2.0-0 libsm6 libxrender1 libxext6

    ## R packages
    # libicu70 stringr
    # amd64 is served from archive.ubuntu.com and arm64 from ports.ubuntu.com.
    case "$(uname -m)" in
        x86_64) url="http://archive.ubuntu.com/ubuntu/pool/main/i/icu/libicu70_70.1-2_amd64.deb" ;;
        aarch64) url="http://ports.ubuntu.com/ubuntu-ports/pool/main/i/icu/libicu70_70.1-2_arm64.deb" ;;
        *) echo "ERROR: Unsupported architecture: $(uname -m)"; exit 1 ;;
    esac
    wget -nv -O libicu70.deb "$url"
    dpkg -i libicu70.deb && rm libicu70.deb

    # System requirements from Posit Package Manager, grouped by assets/r-build-essential/group_apt_by_rpkg.py
    # https://packagemanager.posit.co/client/#/repos/cran/setup
    # https://packagemanager.posit.co/client/#/repos/bioconductor/setup
    apt-get -y install automake # surveyvoi
    apt-get -y install bwidget # FFD MDSGUI PBSmodelling asbio biplotbootGUI canceR cncaGUI multibiplotGUI
    # apt-get -y install chromium # RPushbullet chromote liteformats nomnoml provolleyballr qtkit
    apt-get -y install cmake # MPCR ROpenCVLite RbowtieCuda RcppParallel RcppPlanc Rduckhts Uno abn arrow craftgrn crc32c fs highs libdeflate libimath libopenexr nloptr openfhe.R otelsdk rbedrock rlibkriging rswipl s2 scip sundialr symengine talib tiledb
    apt-get -y install coinor-libclp-dev # coinclp pcaL1
    apt-get -y install coinor-libsymphony-dev # Rsymphony
    apt-get -y install coinor-symphony # Rsymphony
    apt-get -y install dcraw # adimpro
    apt-get -y install default-jdk # AWR BeastJar CBSr CHRONOS CirceR CohortIncidence CohortMethod CommonJavaJars Crossover DatabaseConnector Deducer EvidenceSynthesis GreedyExperimentalDesign GreedyExperimentalDesignJARs IRISSeismic InSilicoVA JGR JavaGD KEGGlincs LeafArea NGCHM OnassisJavaLibs OpenStreetMap RBioFormats RH2 RJDemetra RJSDMX RKEA RKEAjars RMOA RMOAjars RNetLogo RWeka RWekajars Rcurvep RedeR SDMtune SELEX SqlRender XLConnect arulesCBA arulesNBMiner bartMachine bartMachineJARs bfw coreNLP corehunter denguedatahub dialr dialrjars dismo fastreeR fsdaR gMCP ggdemetra glmulti h2o helloJavaWorld informativeSCI jvecfor mailR mallet matchingMarkets metabinR mutossGUI mwa nlrx openNLP openNLPdata qCBA r2pmml r5r rCBA rGroovy rJava rapidraker rcdk rflsgen rgph rjd3bench rjd3jars rjd3providers rjd3toolkit rjd3tramoseats rjd3workspace rjd3x13 rjd3xjars rjdmarkdown rjdqa rkafkajars rmcfs rmelting rsparkling rsubgroup rviewgraph sarks sasquatch simona simplace slowraker spcosa staplr streamMOA tabulapdf transcriptogramer venneuler wordnet xlsx xlsxjars
    apt-get -y install gdal-bin # CoordinateCleaner CopernicusMarine FedData GWnnegPCA GWpcor ICESat2VegR PlanetNICFI RCzechia SpatialArtifacts abn bamm concaveman deforestable ebvcube esviz evapoRe gdalraster kuenm2 manureshed mapme.biodiversity mlr nlrx pRecipe rlas sapo sf smile spatsoc terra tiler twc vapour warbleR
    apt-get -y install git # NGCHM RcppPlanc atime corteza credentials dataMaid dataReporter fgitR findInGit gitcreds gittargets pensar precommit remotes switchr tiledb updateObject
    apt-get -y install gsfonts # Thermimage adimpro animation bamm colorizer flowcatchR idm magick magickGUI oceanmap webshot
    apt-get -y install imagej # LeafArea
    apt-get -y install jags # BCHM BTSPAS BayLum BayesCACE BayesGWQS BayesPostEst BayesTools BeQut COMBO EBASE EWOC.Comb EcoDiet HiLDA ISEtools JMbayes JointAI MBNMAdose MBNMAtime MethComp MigConnectivity MixSIAR NMADTA NobBS PVAClone R2jags RcmdrPlugin.RMTCJags RoBMA RoBSA Romeb SIBER TreeBUGS UHM abn altmeta bacistool baker bamdit bayescount beer bfw bhmbasket buzzMed dclone dcmle infercnv jagsUI jagstargets jarbes lcra mlr morse morseDR neojags occumb optimalThreshold ordinalbayes pcnetmeta phase1PRMD popbayes prevalence remiod rjags runjags saeHB saeHB.Spatial.Beta saeHB.panel saeHB.panel.beta saeHB.spatial saeHB.twofold saeHB.unit serodynamics sharx sims snSMART sparsesurv surveyvoi unmconf
    apt-get -y install make # ABC.RAP AV1R AovBay BASiCStan BGVAR BIDistances BINtools BPrinStratTTE BRRAT BSPBSS BUSpaRse BayesGmed BayesGrowth BayesPET BayesSenMC BayesXsrc BayesianPlatformDesignTimeTrend BeeGUTS Bernadette BigDataStatMeth BinaryReplicates BioCro BivRec Boom BoundIRT CARME CNVRG CWT CaseBasedReasoning CausalQueries ChemmineR ClustIRR CompositionalRF CytoML DA DCPO DER DNAtools DataVisualizations DatabionicSwarm DiffBind DropletUtils ECOSolveR EcoEnsemble EloSteepness EpiNow2 EpiPvr Epoch FLAMES FLSSS FlexReg ForceChoice GBScleanR GGPA GMLTM GPA GUD GWmodel GeneralizedUmatrix GeneralizedUmatrixGPU GeoFIS HD2013SGI HHBayes HIBAG HiSpaR HilbertVisGUI IBRtools IgGeneUsage IncDTW JavaGD LMMELSM MADPop MDCcure MIRES MUACz MetaStan MetaboDynamics NNS OncoBayes2 OpenCL OpenMx Orcs PReMiuM PSPI PoolTestR ProbBreed QuantRegGLasso QuasR QuickJSR R2D2ordinal RBesT RCurl RProtoBufLib RSiena RUCova Rarr Rbowtie Rbowtie2 RbowtieCuda Rbwa RcppCWB RcppPlanc Rduckhts Rfastp Rhisat2 Rlgt Rmixmod RoBTT Rsamtools Rserve RsimdDispatch Rsomoclu Rtinycc Rtwobitlib SAIGEgds SAR SBMTrees SLGP SVP Scalelink SharedObject SimJoint SparseChol SpatMCA SpatPCA SpliceWiz StMoSim StanHeaders StanMoMo SteadyStateBVAR TCIU TDA TableContainer TriDimRegression Uno VariantAnnotation WOAkMedoids WSPsignal WhiteLabRt YPBP YPPE alabaster.base aphid ast2ast asteRisk baggr bakR baldur bamsignals batchmix bayes4psy bayesZIB bayesdfa bayesforecast bayeslist bayeslm bbmix bcf bclogit beachmat.hdf5 beastt beezdemand bellreg bennu bfp bioacoustics birdie bistablehistory blavaan bmgarch bmggum bmlm bmstdr bootUR bqmm breathteststan bscm bsynth bws catSurv cbq cellmig cgvR chihaya clarabel cloneRate clustTMB conStruct concatipede conleyreg cppRouting crqa csaw ctsem cubature cvLM cytolib dada2 dbmss decemedip decontX deepSNV densEstBayes detectXOR detrendr diffHic diffuStats disaggregation disbayes distops divent dodgr drf drogonR dtwclust dynBiplotGUI dynr eDNAjoint eaf edgemodelr eggCounts epial