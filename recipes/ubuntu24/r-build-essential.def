    # apt-get -y install nvidia-cuda-dev # CMCMC MPCR RbowtieCuda cudaverse cusna gcbd rwig
    # apt-get -y install ocl-icd-opencl-dev # BIDistances GeneralizedUmatrixGPU OpenCL glmbayes glmbayesCore nmathopencl opencltools
    apt-get -y install pandoc # BCFM BIDistances CHRONOS DataExplorer DataPackageR DatabionicSwarm DiscoRhythm EnTraineR EpiSignalDetection FCPS FeNEU GeneralizedUmatrix GeneralizedUmatrixGPU GerminaR NACHO OncoBayes2 PTXQC PreKnitPostHTMLRender RAQSAPI RBesT RCAS REPLesentR RmdConcord SpectriPy StanHeaders TDCM TreeDist abseqR accessr anticlust apathe autoharp bayesplot biblio blandr blastula blogdown bookdown breathtestcore brinton bssm clinDataReview clinUtils coveffectsplot crandep dataMaid dataReporter dbmss divent emayili entropart exams exmort ezknitr flexsiteboard footBayes frequency ftExtra ggExtra ggquickeda ggtrace glioblastomaEHRsData govdown goxygen grwat hoopR huito idiogramFISH inTextSummaryTable inlpubs inti knitr learnr lightsout loo memoiR mindr minidown nbconvertR nlrx oddsapiR officedown openPrimeR opencpu pagedown pander pandocfilters papaja paws.common pedometrics pensar pivmet pkgdown pkgnews prettydoc rapport rchallenge reportfactory reprex revise rfriend rgl rmarkdown rmdfiltr rstan rstanarm rstantools rswipl shinyInvoice shinyWGD shinyloadtest shinyscholar simplermarkdown sportyR tables texor texreg tidycwl vitae worcs workflowr yamlme
