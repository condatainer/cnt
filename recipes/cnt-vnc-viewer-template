#!/usr/bin/env bash
#DESC:cnt-vnc-viewer {version}, a browser VNC client with audio and clipboard
#URL:https://github.com/condatainer/cnt-vnc-viewer
#TARGET:cnt-vnc-viewer/{version}

#PH:version:0.1.0

#AUTOUPDATE:version:github condatainer/cnt-vnc-viewer regex=@version min=0.1.0 verify=head

#SOURCE:bin amd64 https://github.com/condatainer/cnt-vnc-viewer/releases/download/v{version}/cnt-vnc-viewer-linux-musl-amd64
