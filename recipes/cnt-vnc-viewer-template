# A static musl binary with the frontend embedded, so it runs on any base.
mkdir -p "$CNT_BUILD_PREFIX/bin"
install -m 0755 "$CNT_BUILD_SRC_bin" "$CNT_BUILD_PREFIX/bin/cnt-vnc-viewer"
