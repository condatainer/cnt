#!/bin/bash
#DESC: VS Code Tunnel (with relay server)

#NCPU: 4
#MEM: 16G
#TIME: 12:00:00
#SINGLETON: true

#PARAM: AUTH=github --auth,-a "Authentication provider"
#VALUE: AUTH=github | microsoft

#PARAM: MACHINE_NAME=? --name,-n "Tunnel name (auto-set on first run, saved to config)"
#PARAM: CODE_DIR=? --code-dir,-d "Directory for the VS Code CLI and server (default: $SCRATCH/.vscode, else ~/.vscode)"

# MACHINE_NAME is injected by the Go wrapper from saved config.
# On first run it is empty: compute from user+domain, save for all future runs.
if [ -z "${MACHINE_NAME:-}" ]; then
    _h="$(hostname -f 2>/dev/null || hostname -s)"
    case "$_h" in *.*) _h="${_h#*.}" ;; esac  # node.netname.domain → netname.domain
    MACHINE_NAME="$(whoami)-$(printf '%s' "$_h" | tr '.' '-')"
    MACHINE_NAME="${MACHINE_NAME:0:20}"
    condatainer helper "$CNT_HELPER_NAME" config set MACHINE_NAME "$MACHINE_NAME"
    condatainer _helper message "Tunnel name set to: $MACHINE_NAME"
fi

# The VS Code CLI and server live under CODE_DIR so they persist across jobs.
# Default: scratch when it is set and writable, else the home directory.
if [ -z "${CODE_DIR:-}" ]; then
    if [ -n "${SCRATCH:-}" ] && [ -w "$SCRATCH" ]; then
        CODE_DIR="$SCRATCH/.vscode"
    else
        CODE_DIR="$HOME/.vscode"
    fi
fi
CODE_BIN="$CODE_DIR/bin/code"
export VSCODE_CLI_DATA_DIR="$CODE_DIR/cli"
# Keep the login in a plain file under CODE_DIR, so one login works on every node.
export VSCODE_CLI_USE_FILE_KEYCHAIN=1 VSCODE_CLI_DISABLE_KEYCHAIN_ENCRYPT=1
mkdir -p "$CODE_DIR/server"
if [ ! -f "$CODE_BIN" ]; then
    echo "Downloading VS Code CLI..."
    ARCH=$(uname -m)
    case "$ARCH" in
        x86_64)  ARCH="linux-x64" ;;
        aarch64) ARCH="linux-arm64" ;;
        *)
            condatainer _helper message --level error "Unsupported architecture: $ARCH"
            exit 1
            ;;
    esac
    mkdir -p "$(dirname "$CODE_BIN")"
    if ! wget -q -O "$CNT_HELPER_TMPDIR/vscode-cli.tar.gz" \
        "https://update.code.visualstudio.com/latest/cli-${ARCH}/stable"; then
        condatainer _helper message --level error "Could not download the VS Code CLI."
        exit 1
    fi
    tar -xzf "$CNT_HELPER_TMPDIR/vscode-cli.tar.gz" -C "$(dirname "$CODE_BIN")" code
    rm -f "$CNT_HELPER_TMPDIR/vscode-cli.tar.gz"
    chmod +x "$CODE_BIN"
    echo "VS Code CLI installed: $("$CODE_BIN" --version | head -1)"
else
    _update=$("$CODE_BIN" update 2>&1 || true)
    case "$_update" in
        *"Successfully updated"*)
            echo "VS Code CLI: $(printf '%s\n' "$_update" | tail -1)" ;;
    esac
fi

_show="$("$CODE_BIN" tunnel user show 2>&1)"
if ! echo "$_show" | grep -qi "^logged in with provider ${AUTH:-github}"; then
    "$CODE_BIN" tunnel user logout 2>/dev/null || true
    "$CODE_BIN" tunnel user login --provider "${AUTH:-github}" 2>&1 | while IFS= read -r line; do
        echo "$line"
        case "$line" in
            *github.com/login/device*|*microsoft.com/devicelogin*|*"To grant access"*|*"Enter code"*)
                condatainer _helper message "$line" ;;
        esac
    done
fi

"$CODE_BIN" tunnel \
    --accept-server-license-terms \
    --server-data-dir "$CODE_DIR/server" \
    --extensions-dir "$CODE_DIR/server/extensions" \
    --name "$MACHINE_NAME" &
TUNNEL_PID=$!

# Brief pause — lets fast failures (name conflict, auth error) surface before declaring ready.
sleep 3
if ! kill -0 "$TUNNEL_PID" 2>/dev/null; then
    condatainer _helper message --level error \
        "VS Code Tunnel failed to start."
    exit 1
fi

condatainer _helper ready \
    --port 0 \
    --external-url "https://vscode.dev/tunnel/${MACHINE_NAME}${CNT_HELPER_CWD}"

wait $TUNNEL_PID
EXIT_CODE=$?
if [ $EXIT_CODE -ne 0 ]; then
    condatainer _helper message --level error \
        "VS Code Tunnel exited (code $EXIT_CODE)."
fi
exit $EXIT_CODE
