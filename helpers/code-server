#!/bin/bash
#DESC: code-server (open-source VS Code, browser-based)

#NCPU: 4
#MEM: 16G
#TIME: 12:00:00

#DEP: code-server

#PARAM: PASSWORD=? --password "Password for authentication (empty for no auth)"

condatainer _helper message \
    "code-server cannot use Microsoft proprietary extensions such as Pylance or Copilot. Use vscode-server if you need them."

if [ -n "${PASSWORD:-}" ]; then
    condatainer _helper message "Password: ${PASSWORD}"
    export PASSWORD
    AUTH_OPTS="--auth password"
else
    AUTH_OPTS="--auth none"
fi

code-server \
    --disable-update-check \
    --bind-addr "${CNT_HELPER_BIND_ADDR:-127.0.0.1}:${CNT_HELPER_PORT}" \
    $AUTH_OPTS \
    "${CNT_HELPER_CWD:-.}" &
PID=$!

# code-server's parent process gives its child a fixed 10s to start, so a slow
# file system makes it exit with "timed out".
if ! condatainer _helper ready \
    --port "$CNT_HELPER_PORT" \
    --pid "$PID" \
    --url-path "?folder=${CNT_HELPER_CWD}"; then
    condatainer _helper message --level error \
        "code-server exited while starting. If the log says \"timed out\", the file system was too slow for its 10s start limit; resubmit later."
    exit 1
fi

wait $PID
