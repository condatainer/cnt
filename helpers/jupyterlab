TOKEN=$(python3 -c "import secrets; print(secrets.token_hex(8))" 2>/dev/null \
    || openssl rand -hex 8 2>/dev/null \
    || echo "$(date +%s)$RANDOM")

# The token goes in the environment, so it is not in the process arguments other users can see.
export JUPYTER_TOKEN="$TOKEN"
# Runtime files (connection files, cookie secret) on node-local storage.
export JUPYTER_RUNTIME_DIR="$CNT_HELPER_TMPDIR/jupyter-runtime"
mkdir -p "$JUPYTER_RUNTIME_DIR"

jupyter-lab \
    --no-browser \
    --ip="${CNT_HELPER_BIND_ADDR:-127.0.0.1}" \
    --port "$CNT_HELPER_PORT" \
    ${CNT_HELPER_BIND_ALL:+--ServerApp.allow_remote_access=True} &
PID=$!

condatainer _helper ready \
    --port "$CNT_HELPER_PORT" \
    --pid "$PID" \
    --url-path "?token=$TOKEN"

wait $PID
